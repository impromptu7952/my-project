{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playzone.kids/schemas/production_spec.v1.json",
  "title": "ProductionSpec",
  "type": "object",
  "required": [
    "version",
    "language",
    "age_band",
    "episode_slug",
    "learning_goals",
    "vocabulary",
    "structure"
  ],
  "properties": {
    "version": { "type": "string", "const": "1" },
    "language": { "type": "string", "const": "sq" },
    "age_band": { "type": "string", "enum": ["1-2", "2-3", "1-3"] },
    "episode_slug": { "type": "string", "minLength": 1 },
    "learning_goals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "vocabulary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["word"],
        "properties": {
          "word": { "type": "string" },
          "en": { "type": "string" },
          "props": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "structure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["block"],
        "properties": {
          "block": { "type": "string" },
          "duration_seconds": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "principles": {
      "type": "object",
      "properties": {
        "short_phrases": { "type": "boolean" },
        "pause_seconds": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "outputs_required": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
